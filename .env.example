# ─────────────────────────────────────────────
# Anime Notes — Environment Configuration
# Copy this file to `.env` and fill in your values
# ──────────────────────────────────────────

# App display name (shown in header)
EXPO_PUBLIC_APP_NAME=Anime Notes

# Theme mode: "light" | "dark"
EXPO_PUBLIC_THEME_MODE=light

# Maximum notes allowed (0 = unlimited)
EXPO_PUBLIC_MAX_NOTES=500
